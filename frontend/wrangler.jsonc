{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mellosoft",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mellosoft-db",
      "database_id": "YOUR_CLOUDFLARE_D1_DATABASE_ID_HERE"
    }
  ],
  "observability": {
    "enabled": true
  }
}
