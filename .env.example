# ==============================================================================
# MELLOSOFT PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env on the production VPS and populate with operator-generated secrets.
# NEVER commit the real .env file or production passwords to version control.
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# Canonical Application URL (used for CORS, redirects, and webhooks)
APP_URL=https://mellosoft.in
NEXT_PUBLIC_APP_URL=https://mellosoft.in

# Session Security Secret
# Generate on Linux using: openssl rand -hex 32
SESSION_SECRET=replace_with_64_character_hex_random_secret

# PostgreSQL Database Configuration
# These are consumed by both the docker-compose postgres container and Prisma ORM
POSTGRES_DB=mellosoft
POSTGRES_USER=mellosoft_user
# Generate on Linux using: openssl rand -hex 24 (use hex so characters do not break URL parsing)
POSTGRES_PASSWORD=replace_with_secure_database_password

# Prisma Database Connection String
# Inside Docker network: host is "postgres". For native host setup: host is "localhost"
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# ------------------------------------------------------------------------------
# Payment Gateway Credentials (Optional: COD and UPI work without external keys)
# ------------------------------------------------------------------------------

# Razorpay (Live or Test credentials from Razorpay Dashboard)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Stripe (Live or Test credentials from Stripe Dashboard)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# ------------------------------------------------------------------------------
# Email / SMTP Notifications Configuration (Optional)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=orders@mellosoft.in
